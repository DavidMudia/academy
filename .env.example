PORT=4000
DATABASE_PATH=server/data/oldam.sqlite
UPLOADS_PATH=server/data/uploads
FRONTEND_URL=http://127.0.0.1:5173
PUBLIC_API_URL=http://127.0.0.1:4000

# Bootstrap a private administrator account. Use a unique password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Paystack test or live secret key. Keep it server-side only.
PAYSTACK_SECRET_KEY=sk_test_replace_me

# SMTP email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_TEMPLATE_NAME=oldam_account_update
WHATSAPP_TEMPLATE_LANGUAGE=en
